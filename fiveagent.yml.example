model:
  provider: openai-compatible
  base_url: http://host.docker.internal:11434/v1   # Ollama default; or https://api.openai.com/v1, https://api.deepseek.com/v1
  api_key: ""            # empty for local Ollama
  name: llama3.1         # or gpt-4o-mini, deepseek-chat, ...

# Optional: the agent's persona. Whatever you write (or the built-in default)
# gets one extra line naming the configured model, so the agent can say
# plainly what it runs on instead of inventing an identity.
# system_prompt: "You are FiveAgent, a helpful personal assistant. Be concise and warm."

channels:
  telegram:
    enabled: false
    # Create a bot with @BotFather on Telegram, paste the token here:
    # bot_token: "123456:ABC-DEF..."
    # No public URL needed: the agent polls Telegram, so it works on any PC.
  whatsapp:
    enabled: false
    # Official WhatsApp Cloud API (Meta):
    # access_token: ${WHATSAPP_ACCESS_TOKEN}     # permanent system-user token
    # phone_number_id: "1234567890"              # from the Meta app dashboard
    # verify_token: "pick-a-random-string"       # you choose it; Meta checks it
    # app_secret: <Meta app secret>              # enables webhook signature checks
    # allowed_senders: ["34600000000"]           # solo estos números reciben respuesta;
    # con prefijo de país, sin el "+", separados por comas. Vacío = contesta a cualquiera.
    # listen_addr: ":8080"                       # webhook listener
  imessage:
    enabled: false

memory:
  # Simplest for a first local run: a JSON file next to the binary.
  # json: fiveagent-memory.json
  # For docker compose / real deployments use Postgres (set DB_PASSWORD in .env).
  postgres: postgres://fiveagent:${DB_PASSWORD}@db:5432/fiveagent

# sandbox: per-user isolated execution for the run_command tool.
#   enabled: false
#   backend: auto          # auto | bubblewrap (Linux) | appcontainer (Windows) | jobobject | docker
#   Nota Ubuntu 24.04+: si bubblewrap falla con "Failed RTM_NEWADDR",
#   ejecuta: sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
#   root: data/sandbox     # one writable folder per user inside it
#   timeout: 30            # seconds per command
#   max_ram_mb: 512        # docker / jobobject only
#   image: alpine          # docker only
