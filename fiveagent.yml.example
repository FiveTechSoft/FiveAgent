model:
  provider: openai-compatible
  base_url: http://host.docker.internal:11434/v1   # Ollama default; or https://api.openai.com/v1, https://api.deepseek.com/v1
  api_key: ""            # empty for local Ollama
  name: llama3.1         # or gpt-4o-mini, deepseek-chat, ...
  # timeout: 120         # seconds per model call; local endpoints default to 600
  # num_thread: 8        # Ollama only: cap inference threads (good neighbor on shared CPU hosts).
                         # When set, requests go to Ollama's native /api/chat, so base_url must end in /v1.

# Optional: a second model for code-heavy requests. When set, the agent
# auto-routes: messages that look like code go here, everything else to
# model above. base_url, provider and api_key are inherited from model if omitted.
# coder:
#   name: qwen3.8:27b    # or deepseek-chat, gpt-4o-mini, ...

# Optional: the agent's persona. Whatever you write (or the built-in default)
# gets one extra line naming the configured model, so the agent can say
# plainly what it runs on instead of inventing an identity.
# system_prompt: "You are FiveAgent, a helpful personal assistant. Be concise and warm."

channels:
  telegram:
    enabled: false
    # Create a bot with @BotFather on Telegram, paste the token here:
    # bot_token: "123456:ABC-DEF..."
    # No public URL needed: the agent polls Telegram, so it works on any PC.
    # allowed_senders: ["123456789"]                # Telegram chat IDs; empty = answer anyone
  whatsapp:
    enabled: false
    # Official WhatsApp Cloud API (Meta):
    # access_token: ${WHATSAPP_ACCESS_TOKEN}     # permanent system-user token
    # phone_number_id: "1234567890"              # from the Meta app dashboard
    # verify_token: "pick-a-random-string"       # you choose it; Meta checks it
    # app_secret: ${FIVEAGENT_META_APP_SECRET}   # Meta app secret: verifies webhook
    #                                            # signatures (HMAC). Without it the bot
    #                                            # logs a loud WARNING and runs UNVERIFIED.
    # allowed_senders: ["34600000000"]           # solo estos números reciben respuesta;
    # con prefijo de país, sin el "+", separados por comas. Vacío = contesta a cualquiera
    # (WARNING ruidoso al arrancar - no pongas tu número real en el repo).
    # listen_addr: ":8080"                       # webhook listener
    # reactions: "off"                           # default: eyes while working, check when
    #                                            # the reply lands, warning on failure
    # debounce: "off"                            # default "3s": joins a sender's rapid
    #                                            # message bursts into one turn, one reply
  imessage:
    enabled: false

memory:
  # Long-term memory folder: markdown files versioned with git. The agent
  # recalls it every turn and curates it with save_memory/forget_memory.
  knowledge: data/memory
  # Simplest for a first local run: a JSON file next to the binary.
  # json: fiveagent-memory.json
  # For docker compose / real deployments use Postgres (set DB_PASSWORD in .env).
  # ${VAR} values in this file are expanded from the environment at load
  # time - this is how to keep secrets out of the yml.
  postgres: postgres://fiveagent:${DB_PASSWORD}@db:5432/fiveagent

# sandbox: per-user isolated execution for the run_command tool. ON by
# default (it protects your machine from the agent's shell commands);
# set enabled: false to opt out. If no backend is available on this
# machine, startup logs "sandbox disabled: ..." and keeps running.
#   backend: auto          # auto | bubblewrap (Linux) | appcontainer (Windows) | jobobject | docker
#   Nota Ubuntu 24.04+: si bubblewrap falla con "Failed RTM_NEWADDR",
#   ejecuta: sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
#   root: data/sandbox     # one writable folder per user inside it
#   timeout: 30            # seconds per command
#   max_ram_mb: 512        # docker / jobobject only
#   image: alpine          # docker only

# trajectory: opt-in turn recorder (stage 12). Every turn lands redacted
# as a JSONL trajectory - the dataset shape for stage 13 fine-tuning.
# trajectory:
#   enabled: true
#   # dir: data/trajectories   # rotating trajectories.jsonl lives here
#   # max_mb: 10               # per rotating file
#   # max_files: 5             # rotated files kept

# mcp: local MCP server for external agents (e.g. your OpenCode). Off by
# default. Needs sandbox.enabled: true - fiveagent_run_command is the point.
# See docs/mcp.md for the client config and a curl smoke test.
# mcp:
#   enabled: true
#   token: "pick-a-long-random-token"   # required; bearer token
#   # listen_addr: "127.0.0.1:8090"     # default; keep it on loopback
#   # user_key: "mcp"                   # sandbox folder for MCP calls

# web_search: optional web_search tool for current facts. Off by default.
# web_search:
#   enabled: false         # set true to let the agent search the web
#   provider: duckduckgo   # duckduckgo (default, no API key) | brave
#   # api_key: ""          # brave only: https://brave.com/search/api/
#   # max_results: 5       # per search, hard cap 10
